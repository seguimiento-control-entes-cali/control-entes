+/* Dependencia de una acción importada, en este orden: nombre completo (en el responsable o en el lugar
+   de verificación), sigla (DAGMA, DATIC, DAPM, UAESPM…), «tipo + primera palabra» cuando es única
+   («Secretaría del Deporte»), y solo al final el nombre corto. Así «Subsecretario de Infraestructura
+   Deportiva - Secretaría del Deporte» no se asigna a Infraestructura. */
+const PM_DEP_CONECTORES = new Set(['de', 'del', 'la', 'las', 'los', 'el', 'y', 'e', 'para']);
+function pmDepSigla(txt) {
+  const t =
+    ' ' +
+    String(txt || '')
+      .normalize('NFD')
+      .replace(/[\u0300-\u036f]/g, '')
+      .toUpperCase()
+      .replace(/[^A-Z0-9]+/g, ' ') +
+    ' ';
+  const hits = S.deps.filter(d => {
+    const pal = orgKey(d.nombre)
+      .split(' ')
+      .filter(w => w && !PM_DEP_CONECTORES.has(w));
+    const sigla = pal
+      .map(w => w[0])
+      .join('')
+      .toUpperCase();
+    const entre = (/\(([A-Za-z]{4,})\)/.exec(d.nombre) || [])[1];
+    return (
+      (sigla.length >= 4 && t.includes(' ' + sigla + ' ')) ||
+      (entre && t.includes(' ' + entre.toUpperCase() + ' '))
+    );
+  });
+  return hits.length === 1 ? hits[0].id : null;
+}
+function pmDepCabeza(txt) {
+  const k = ' ' + orgKey(txt) + ' ';
+  const cab = d => {
+    const w = orgKey(d.nombre).split(' ');
+    const i = w.findIndex(
+      (x, n) => n > 0 && PM_DEP_CONECTORES.has(x) && w[n + 1] && !PM_DEP_CONECTORES.has(w[n + 1])
+    );
+    return i > 0 ? w.slice(0, i + 2).join(' ') : null;
+  };
+  const cabezas = S.deps.map(d => [d, cab(d)]).filter(x => x[1]);
+  const hits = cabezas.filter(
+    ([, c]) => k.includes(' ' + c + ' ') && cabezas.filter(y => y[1] === c).length === 1
+  );
+  return hits.length === 1 ? hits[0][0].id : null;
+}
+function pmDepImport(resp, lugar) {
+  return (
+    pmDepMatch(resp, true) ||
+    pmDepMatch(lugar, true) ||
+    pmDepSigla(resp) ||
+    pmDepSigla(lugar) ||
+    pmDepCabeza(resp) ||
+    pmDepCabeza(lugar) ||
+    pmDepMatch(resp) ||
+    pmDepMatch(lugar)
+  );
+}
